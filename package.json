{
  "name": "capify-loan-calculator",
  "version": "1.0.0",
  "description": "Business Loan Calculator for WordPress - Build tools and development dependencies",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "terser capify-loan-calculator/assets/js/calculator.js -o capify-loan-calculator/assets/js/calculator.min.js --compress --mangle --source-map",
    "build:css": "cleancss -o capify-loan-calculator/assets/css/calculator.min.css capify-loan-calculator/assets/css/calculator.css",
    "lint:js": "eslint capify-loan-calculator/assets/js/**/*.js",
    "lint:js:fix": "eslint capify-loan-calculator/assets/js/**/*.js --fix",
    "watch": "npm-run-all --parallel watch:*",
    "watch:js": "terser capify-loan-calculator/assets/js/calculator.js -o capify-loan-calculator/assets/js/calculator.min.js --compress --mangle --source-map --watch",
    "watch:css": "cleancss -o capify-loan-calculator/assets/css/calculator.min.css capify-loan-calculator/assets/css/calculator.css --watch",
    "dev": "npm run watch",
    "clean": "rm -f capify-loan-calculator/assets/js/*.min.js capify-loan-calculator/assets/css/*.min.css capify-loan-calculator/assets/js/*.map"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vasilelazarescu/Capify-BL-Calculator"
  },
  "keywords": [
    "wordpress",
    "loan-calculator",
    "finance",
    "business-loan",
    "calculator",
    "elementor"
  ],
  "author": "Capify",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "eslint": "^8.56.0",
    "eslint-config-wordpress": "^2.0.0",
    "npm-run-all": "^4.1.5",
    "terser": "^5.26.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
